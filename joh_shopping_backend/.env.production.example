# Production settings for the API. Copy to .env on the server, then:
#   php artisan key:generate --force
APP_NAME="Joh Shopping"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.johshopping.com

# Storefront (email links, CORS) and the domains allowed to use Sanctum cookies.
FRONTEND_URL=https://johshopping.com
CORS_ALLOWED_ORIGINS=https://johshopping.com,https://www.johshopping.com
SANCTUM_STATEFUL_DOMAINS=johshopping.com,www.johshopping.com

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Nginx on the same server: 127.0.0.1. Behind Cloudflare: *
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joh_shopping
DB_USERNAME=joh_shopping
DB_PASSWORD=

# Cookies shared by johshopping.com and api.johshopping.com, HTTPS only.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.johshopping.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.johshopping.com
MAIL_PORT=465
MAIL_USERNAME=support@johshopping.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@johshopping.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL=support@johshopping.com

# Payments. The sandbox never collects money, so on production card and mobile
# money stay hidden until a real gateway driver is set here. Cash on delivery
# can be switched on in Admin → Settings meanwhile.
PAYMENTS_MOBILE_MONEY_DRIVER=sandbox
PAYMENTS_CARD_DRIVER=sandbox
PAYMENTS_ALLOW_SANDBOX=false
PAYMENTS_SANDBOX_AUTO_CONFIRM=false

# First `php artisan db:seed --force` only: the Super Admin's password (remove afterwards).
SEED_DEMO_DATA=false
ADMIN_PASSWORD=

# Admin edits refresh the storefront cache at once (same value as the frontend REVALIDATE_SECRET).
STOREFRONT_REVALIDATE_SECRET=
STOREFRONT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
