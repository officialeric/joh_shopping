# Public site URL (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API (../joh_shopping_backend). The browser calls it with Sanctum cookies.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Optional: a faster/internal URL for server-side fetches (build + catalog cache)
# API_URL=http://127.0.0.1:8000/api

# Shared with the API's STOREFRONT_REVALIDATE_SECRET: admin edits refresh the cached catalog at once
REVALIDATE_SECRET=dev-revalidate-secret

# Demo logins on the sign-in pages (set to false on a live store)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
