# Production settings for the storefront. Copy to .env.production.local on the server.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.

NEXT_PUBLIC_SITE_URL=https://johshopping.com

# The Laravel API as the browser sees it (Sanctum cookies need the same parent domain).
NEXT_PUBLIC_API_URL=https://api.johshopping.com/api
# Server-side fetches (build + catalog cache). Same URL is fine; an internal one is faster.
API_URL=https://api.johshopping.com/api

# Must equal STOREFRONT_REVALIDATE_SECRET in the API's .env. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Never show demo logins on a live store.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
